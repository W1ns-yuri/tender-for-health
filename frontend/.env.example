# Адрес API, если бэкенд на другом домене (иначе запросы идут на /api через прокси)
# VITE_API_URL=https://api.example.tm/api

# Контакты поддержки в окне «Забыли пароль?». Пусто — строка не показывается.
VITE_SUPPORT_PHONE=
VITE_SUPPORT_EMAIL=

# Кнопки «Демо-доступ» на странице входа. В проде не включать.
VITE_SHOW_DEMO=false
